PORT=3012

# Cloudflare R2 — S3-compatible object storage
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=citymarket-media

# CDN domain fronting the R2 bucket (Cloudflare custom domain)
CDN_URL=https://pub-7511c1b2d5e34cdb8067140032d3eec0.r2.dev

# Shared JWT secret (must match auth-service)
JWT_ACCESS_SECRET=change_me_jwt_access_secret

# Private bucket (public access OFF) for merchants' product-proposal photos. They are only
# shown through short-lived signed URLs and copied to R2_BUCKET when an admin approves.
# No lifecycle rule is needed: catalog-service deletes orphaned photos itself.
R2_PRIVATE_BUCKET=citymarket-media-private
# Development only, when no private bucket exists: keep proposal photos in R2_BUCKET
# SUBMISSION_ALLOW_PUBLIC_BUCKET=false

# Product-proposal photo rules (defaults shown)
# SUBMISSION_IMAGE_FORMATS=jpeg,png,webp
# SUBMISSION_IMAGE_MIN_WIDTH=800
# SUBMISSION_IMAGE_MIN_HEIGHT=800
# SUBMISSION_IMAGE_MAX_BYTES=5242880
# SUBMISSION_UPLOAD_LIMIT=20            # uploads per merchant per window
# SUBMISSION_UPLOAD_WINDOW_MS=600000
# PRIVATE_SIGNED_URL_TTL_SECONDS=600
