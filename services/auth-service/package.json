{
  "name": "auth-service",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:init": "ts-node src/infrastructure/database/init-db.ts",
    "db:seed": "ts-node src/infrastructure/database/seed-db.ts",
    "db:reset": "ts-node src/infrastructure/database/reset-db.ts",
    "migrate:make": "knex migrate:make -x ts --knexfile knexfile.ts",
    "migrate:latest": "knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.ts"
  },
  "dependencies": {
    "@city-market/shared": "file:../../shared",
    "@types/uuid": "^11.0.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.2.9",
    "mysql2": "^3.22.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.39",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
