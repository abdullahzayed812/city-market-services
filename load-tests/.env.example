# Copy to .env and fill in. .env is already covered by the repo root .gitignore's
# `.env` / `.env.*` patterns (with `!.env.example` excepted), so this file is safe
# to commit and .env itself never will be.

# ─── Target ─────────────────────────────────────────────────────────────────────
# Point this at api-gateway directly for local dev and for seeding (nginx's rate
# limits are much stricter - see README "Known limitations" - and will make
# scripts/seed.ts painfully slow). Must include the /api/v1 prefix.
BASE_URL=http://localhost:3000/api/v1

# Used only by scripts/socket-load-runner.ts if the websocket-gateway isn't
# reachable at the same host as BASE_URL on port 3011 (docker-compose default).
# WS_URL=http://localhost:3011

# ─── Test data ──────────────────────────────────────────────────────────────────
# Every account/record this suite creates is named "<TEST_DATA_PREFIX>_<role>_<id>"
# so it is always identifiable and safe for scripts/cleanup.ts to act on.
TEST_DATA_PREFIX=loadtest

# Password used for every account scripts/seed.ts, generate-users.ts and the
# Artillery processors register. The default below matches
# services/auth-service/src/infrastructure/database/seed-db.ts's own committed
# local-dev seed password (already public in the repo, not a secret) - override
# this for any shared/staging environment.
SEED_ACCOUNTS_PASSWORD=password123

# The three DELIVERY_MANAGER accounts that ship in the repo's own seed data.
# There is no API to create a delivery office (see data/README.md) - these are the
# only accounts scripts/seed.ts and the delivery-office/courier scenarios can use
# unless you seed more directly into the database yourself.
DELIVERY_MANAGER_EMAILS=deliverymanager@citymarket.com,deliverymanager2@citymarket.com,deliverymanager3@citymarket.com

# ─── Safety (Phase 27) ──────────────────────────────────────────────────────────
# LOAD_TEST_MODE is informational / for your own scripts or dashboards to key off
# of if useful - nothing in this suite currently branches on it besides logging it.
LOAD_TEST_MODE=true

# scripts/lib/safety.ts refuses to run ANYTHING beyond a localhost target unless
# this is exactly "true". There is no committed staging environment in this repo
# (see config/environments.yml) - only set this if you have explicit authorization
# to load-test the target config/environments.yml's "production" (or any other
# non-local) entry resolves to, and you have read README.md's Safety section.
ALLOW_PRODUCTION_LOAD_TEST=false

# ─── Misc ───────────────────────────────────────────────────────────────────────
# Delay between consecutive requests in scripts/seed.ts, cleanup.ts and
# generate-users.ts, in milliseconds. Raise this if you see 429s while seeding -
# nginx's "auth" rate-limit zone is 10 req/min/IP (see README).
SEED_REQUEST_DELAY_MS=150
