# ─── Database ────────────────────────────────
MYSQL_ROOT_PASSWORD=your_root_password_here
DB_USER=citymarket
DB_PASSWORD=your_db_password_here

# ─── RabbitMQ ────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ─── JWT ─────────────────────────────────────
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_SERVICE_ACCESS_SECRET=your_jwt_service_access_secret_here
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=7d
JWT_SERVICE_ACCESS_EXPIRY=15m

# ─── Service client secrets ───────────────────
# All services use OAuth2 client_credentials to talk to auth-service.
# Set these to strong random strings in production.
ADMIN_SERVICE_CLIENT_SECRET=admin-service-secret
ORDER_SERVICE_CLIENT_SECRET=order-service-secret
DELIVERY_SERVICE_CLIENT_SECRET=delivery-service-secret
WEBSOCKET_GATEWAY_CLIENT_SECRET=websocket-gateway-secret
RATING_SERVICE_CLIENT_SECRET=rating-service-secret
PAYMENT_SERVICE_CLIENT_SECRET=payment-service-secret
CATALOG_SERVICE_CLIENT_SECRET=catalog-service-secret
NOTIFICATION_SERVICE_CLIENT_SECRET=notification-service-secret
VENDOR_SERVICE_CLIENT_SECRET=vendor-service-secret

# ─── Firebase (optional – push notifications) ─
# Provide either the JSON string or a file path (mounted into the container).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# ─── Web app API URLs (baked in at build time by Vite) ───────────────────────
# Point to wherever the nginx gateway is accessible from the browser.
# Default: http://localhost/api/v1  (nginx on host port 80)
VITE_API_URL=http://localhost/api/v1
VITE_API_BASE_URL=http://localhost/api/v1
VITE_WEBSOCKET_URL=http://localhost
