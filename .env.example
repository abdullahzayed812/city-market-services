# ─── Domain ───────────────────────────────────────────────────────────────────
# Your public domain (used for SSL and CORS)
DOMAIN=yourdomain.com

# Set to true by `deploy.sh --ssl` once certs are issued — controls which
# nginx config (HTTP-only vs HTTPS) gets baked into the image on every build.
# Leave false until you've run `deploy.sh --ssl` at least once.
ENABLE_SSL=false

# ─── Database ─────────────────────────────────────────────────────────────────
# Use strong random passwords in production (openssl rand -hex 32)
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_USER=citymarket
DB_PASSWORD=change_me_db_password

# ─── Redis ────────────────────────────────────────────────────────────────────
# Leave empty to run without auth (not recommended in production)
REDIS_PASSWORD=change_me_redis_password

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
# Change from default guest/guest in production
RABBITMQ_USER=citymarket
RABBITMQ_PASSWORD=change_me_rabbitmq_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change_me_jwt_access_secret
# JWT_REFRESH_SECRET is no longer used by auth-service (refresh tokens are opaque,
# hashed, and stored in the sessions table instead of being signed JWTs) — kept
# here only so nothing breaks if something still reads it; safe to remove later.
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret
JWT_SERVICE_ACCESS_SECRET=change_me_jwt_service_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
JWT_SERVICE_ACCESS_EXPIRY=15m

# ─── Service OAuth2 client secrets ────────────────────────────────────────────
# Each service authenticates with Auth Service using these secrets.
# Generate with: openssl rand -hex 32
ADMIN_SERVICE_CLIENT_SECRET=change_me_admin_secret
ORDER_SERVICE_CLIENT_SECRET=change_me_order_secret
DELIVERY_SERVICE_CLIENT_SECRET=change_me_delivery_secret
WEBSOCKET_GATEWAY_CLIENT_SECRET=change_me_ws_secret
RATING_SERVICE_CLIENT_SECRET=change_me_rating_secret
PAYMENT_SERVICE_CLIENT_SECRET=change_me_payment_secret
CATALOG_SERVICE_CLIENT_SECRET=change_me_catalog_secret
NOTIFICATION_SERVICE_CLIENT_SECRET=change_me_notification_secret
VENDOR_SERVICE_CLIENT_SECRET=change_me_vendor_secret

# ─── Cloudflare R2 (media storage) ───────────────────────────────────────────
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=citymarket-media
CDN_URL=https://pub-7511c1b2d5e34cdb8067140032d3eec0.r2.dev

# ─── Firebase (push notifications) ────────────────────────────────────────────
# Option A: Pass the JSON content as a string (escape quotes)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: Mount the file and set path (recommended for production)
# Place the file at ./firebase-credentials.json then set:
FIREBASE_CREDENTIALS_FILE=./firebase-credentials.json
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# ─── Freelance couriers (delivery-service) ─────────────────────────────────────
# Couriers without a delivery office who claim jobs themselves from the Courier app.
# See docs/freelance-couriers-audit.md. Leave disabled until freelancers are approved
# in the admin dashboard (Couriers → Pending review).
FREELANCE_ENABLED=false
# Minutes delivery offices get to accept a new delivery before freelancers can see it.
# 0 = offices and freelancers see it at the same time.
OFFICE_PRIORITY_WINDOW_MINS=2
# Freelancers only see/claim jobs whose first pickup is within this distance of their
# last reported location. 0 = no distance filter.
FREELANCE_RADIUS_KM=5
# A freelancer holding more uncollected cash than this (EGP) can't claim new jobs until
# an admin settles with them. 0 = no limit.
FREELANCE_MAX_CASH_HELD=2000
# Freelancers whose app hasn't reported a location within this many minutes aren't
# notified about new jobs (they can still see the list when they open the app).
COURIER_LOCATION_STALE_MINUTES=10

# ─── Web app URLs (baked in at Vite build time) ────────────────────────────────
# Must point to the public URL where nginx is accessible from the browser.
# In production use your domain (with https).
# VITE_API_URL=https://yourdomain.com/api/v1
# VITE_API_BASE_URL=https://yourdomain.com/api/v1
# VITE_WEBSOCKET_URL=https://yourdomain.com

VITE_API_URL=http://localhost/api/v1
VITE_API_BASE_URL=http://localhost/api/v1
VITE_WEBSOCKET_URL=http://localhost
